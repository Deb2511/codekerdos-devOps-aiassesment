# Copy to deploy/.env and fill in real values. Never commit .env.

# Database (use letters and digits only; the password is part of a connection URL)
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=codekudos

# Claude API (set on the server only)
ANTHROPIC_API_KEY=

# Timeouts and retention
CLAUDE_TIMEOUT_SECS=60
RETENTION_DAYS=30

# Address and port HAProxy listens on (the CodeKerdos backend calls this)
# On EC2, use the instance's private IP, for example 10.0.1.25
HAPROXY_BIND=127.0.0.1
HAPROXY_PORT=8080

# Number of backend containers (2 by default; use 1 for the first deployment)
BACKEND_REPLICAS=2

NODE_ENV=production
